<t t-name="sale.report_saleorder_document">
    <t t-call="web.external_layout">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
        <t t-set="address">
            <div t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
            <p t-if="doc.partner_id.vat">
                <t t-if="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                <t t-else="">Tax ID</t>: <span t-field="doc.partner_id.vat"/>
            </p>
        </t>
        <t t-if="doc.partner_shipping_id == doc.partner_invoice_id                              and doc.partner_invoice_id != doc.partner_id                              or doc.partner_shipping_id != doc.partner_invoice_id">
            <t t-set="information_block">
                <strong>
                    <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">
                        Invoicing and Shipping Address:
                    </t>
                    <t t-else="">
                        Invoicing Address:
                    </t>
                </strong>
                <div t-field="doc.partner_invoice_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                    <strong>Shipping Address:</strong>
                    <div t-field="doc.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                </t>
            </t>
        </t>
        <div class="page">
            <h2 class="mt-4">
                <span t-if="doc.state in ['draft','sent']">Quotation # </span>
                <span t-else="">Order # </span>
                <span t-field="doc.name"/>
                <img t-att-src="'/report/barcode/Code128/' + doc.name" style="width:300px;height:50px;float:right" alt="Barcode"/>
            </h2>

            <table class="table table-sm o_main_table table-borderless mt-4">
                <thead>
                    <tr>
                        <th class="text-start">Description</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">
                    <!-- FILTRO PARA LA TABLA PRINCIPAL -->
                    <t t-foreach="doc.order_line" t-as="line">
                        <t t-set="l_name" t-value="(line.name or '').lower()"/>
                        <t t-if="not ('envío' in l_name or 'envio' in l_name or 'validación' in l_name or 'validacion' in l_name)">
                            <tr>
                                <t t-if="not line.display_type">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end o_price_total"><span t-field="line.price_subtotal"/></td>
                                </t>
                                <t t-else="">
                                    <td colspan="99"><span t-field="line.name"/></td>
                                </t>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
        </div>

        <!-- SALTO DE PÁGINA PARA ETIQUETAS -->
        <p style="page-break-before: always; visibility: hidden;">.</p>
        <div class="page">
            <div style="width: 20cm; clear: both; margin: 0 auto;">
                <t t-foreach="doc.order_line" t-as="line">
                    <!-- FILTRO PARA LAS ETIQUETAS -->
                    <t t-set="l_name_label" t-value="(line.name or '').lower()"/>
                    <t t-if="not line.display_type and not ('envío' in l_name_label or 'envio' in l_name_label or 'validación' in l_name_label or 'validacion' in l_name_label)">
                        <t t-foreach="[1, 2, 3, 4]" t-as="i">
                            <div style="width: 9.8cm; height: 5cm; border: 0.1mm solid #ccc; padding: 10px; float: left; text-align: center; box-sizing: border-box; overflow: hidden; margin-bottom: 4px;">
                                <strong t-field="doc.name" style="font-size: 16px;"/>
                                <div style="margin: 8px 0;">
                                    <img t-att-src="'/report/barcode/Code128/' + doc.name" style="width: 8.5cm; height: 1.8cm;"/>
                                </div>
                                <div style="font-size: 13px; font-weight: bold; height: 1.2cm; line-height: 0.6cm; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    <span t-field="line.name"/>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </div>
        </div>
    </t>
</t>